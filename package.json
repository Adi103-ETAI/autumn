{
  "name": "autumn",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "node --test \"electron/ipc/*.test.js\" \"electron/backend/*.test.js\"",
    "ipc:manifest": "node scripts/gen-ipc-manifest.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "electron:dev": "electron . --no-sandbox --disable-gpu",
    "electron:build": "npm run pack:files && npm run build && npm run build:backend && electron-builder --config electron-builder.cjs",
    "dist": "npm run electron:build",
    "build:backend": "node scripts/build-backend.mjs",
    "electron:pack": "npm run pack:files && npm run build && npm run build:backend && electron-builder --config electron-builder.cjs --dir",
    "electron:build:win": "npm run pack:files && npm run build && npm run build:backend && electron-builder --config electron-builder.cjs --win --x64",
    "electron:build:mac": "npm run pack:files && npm run build && npm run build:backend && electron-builder --config electron-builder.cjs --mac",
    "electron:build:linux": "npm run pack:files && npm run build && npm run build:backend && electron-builder --config electron-builder.cjs --linux",
    "pack:check": "node scripts/compute-packaging-files.mjs && node scripts/check-packaging.mjs",
    "pack:files": "node scripts/compute-packaging-files.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
