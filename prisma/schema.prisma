// Autumn — Prisma schema (SQLite)
// Mirrors Autumn's data model: desktop_canvases, bus_state, desktop_code_sync.
// We add: Node, Edge, Task, Message, AgentLog for richer querying.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Wave 1: versioned artifact store (artifacts.* bridge namespace).
// Plain `canvasId` string (no FK): artifacts may outlive a canvas row, and the
// artifacts handlers treat canvas scoping as a soft key.
model Artifact {
  id        String   @id @default(cuid())
  canvasId  String   @default("default")
  nodeId    String?
  name      String
  kind      String   @default("file") // file | text | html | image
  path      String?                   // on-disk path when file-backed
  content   String?                   // inline content when small
  version   Int      @default(1)
  retired   Boolean  @default(false)
  meta      String   @default("{}")   // JSON: source, usage, mime, ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ArtifactVersion[]

  @@index([canvasId, name])
}

// Immutable snapshot per artifact version (save/restore/deleteVersions).
model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version    Int
  content    String?
  path       String?
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([artifactId])
}

// Wave 1: agent session persistence (sessions.* bridge namespace).
// `messages` is a JSON array string (same convention as Canvas.state).
model Session {
  id         String   @id @default(cuid())
  canvasId   String   @default("default")
  nodeId     String?
  engine     String   @default("codex") // codex | claude | opencode | gemini | ...
  externalId String?                    // imported target session id
  title      String   @default("")
  path       String?                    // on-disk transcript path, when known
  messages   String   @default("[]")    // JSON: [{role, text, ts}]
  meta       String   @default("{}")    // JSON: model, tokens, importedFrom, ...
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([canvasId, engine])
}

model Canvas {
  id        String   @id @default(cuid())
  name      String   @default("Untitled Canvas")
  state     String   // JSON: { nodes, connections, navLinks, meta }
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes     Node[]
  edges     Edge[]
  tasks     Task[]
  messages  Message[]
  agentLogs AgentLog[]
}

model Node {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  kind      String   // chat | terminal | screen | sticky | analytics | youtube | remotion
  name      String
  data      String   // JSON: per-kind fields (harness, status, doing, text, url, ...)
  x         Float    @default(0)
  y         Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canvasId])
}

model Edge {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  kind      String   @default("bus") // bus | navigation
  sourceId  String
  targetId  String
  data      String   @default("{}") // JSON: traffic pulses, label, etc.
  createdAt DateTime @default(now())

  @@index([canvasId])
}

model Task {
  id          String   @id @default(cuid())
  canvasId    String
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  seq         Int      // t1, t2, ...
  description String
  status      String   @default("open") // open | blocked | in_progress | done
  assigneeId  String?  // node id that claimed it
  afterIds    String   @default("[]") // JSON array of task seq numbers
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([canvasId])
}

model Message {
  id         String   @id @default(cuid())
  canvasId   String
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  nodeId     String   // destination node (chat node) or "commander"
  role       String   // user | assistant | system | peer | commander
  text       String
  authorId   String?  // node id of the sender (for peer messages)
  createdAt  DateTime @default(now())

  @@index([canvasId, nodeId])
}

// AutumnBus peer registry (mirrors Autumn's bus session/stop/list_peers).
// Kept FK-free (plain canvasId) so bus ops never fail on a missing canvas row.
model BusPeer {
  canvasId String
  nodeId   String
  name     String
  status   String   @default("live") // live | offline | thinking | working | ...
  lastSeen DateTime @default(now())

  @@id([canvasId, nodeId])
  @@index([canvasId])
}

model AgentLog {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  nodeId    String   // destination node id, or "commander" for global events
  kind      String   // commander_plan | agent_status | agent_message | bus_message_peer | task_claim | task_complete | task_add | node_added | node_removed | edge_added | edge_removed | canvas_saved | canvas_loaded | canvas_cleared | duplicate_node
  text      String   @default("") // human-readable summary
  payload   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([canvasId, nodeId])
  @@index([canvasId, createdAt])
}
